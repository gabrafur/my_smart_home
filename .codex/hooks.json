{
  "description": "Route eligible tool output and require a public memory review before finishing a task.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/memory-review.mjs\" hook",
            "timeout": 15,
            "statusMessage": "Checking project memory review"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${LOCAL_AI_MCP_RUNTIME_DIR:-$HOME/.local/share/local-ai-rtx/current}/post_tool_routing.py\"",
            "timeout": 240,
            "statusMessage": "Routing large output through Local AI",
            "additionalContextLimit": 2200
          }
        ]
      }
    ]
  }
}
