{
  "description": "Automatically route eligible large tool output through the private Local AI MCP runtime.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${LOCAL_AI_MCP_RUNTIME_DIR:-$HOME/.local/share/local-ai-rtx/current}/post_tool_routing.py\"",
            "timeout": 240,
            "statusMessage": "Routing large output through Local AI",
            "additionalContextLimit": 2200
          }
        ]
      }
    ]
  }
}
