  {
    "id": "demo_decide",
    "type": "function",
    "name": "Decidir luz externa (sem efeitos)",
    "func": "const policy = flow.get('policy');\nconst sun = flow.get('sun');\nconst alarm = flow.get('alarm');\nif (!policy || sun === undefined || alarm === undefined) {\n    node.status({ fill: 'grey', shape: 'ring', text: 'aguardando fatos' });\n    return null;\n}\nconst night = policy.night_states.includes(sun);\nconst armed = policy.armed_states.includes(alarm);\nconst action = night && armed ? 'ligar' : 'desligar';\nconst reason = !night ? 'é dia' : armed ? 'noite e alarme armado' : 'noite, mas alarme desarmado';\nmsg.payload = {\n    entity: 'light.entrance_color_white_lights',\n    action,\n    reason,\n    sun,\n    alarm,\n    simulated: true,\n    dispatched: false,\n    decided_at: new Date().toISOString(),\n};\nnode.status({ fill: action === 'ligar' ? 'yellow' : 'blue', shape: 'dot', text: action + ': ' + reason });\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 800,
    "y": 120,
    "wires": [
      [
        "demo_decision_out"
      ]
    ],
    "z": "demo_tab",
    "g": "demo_group_decision"
  },
