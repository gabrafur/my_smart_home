  {
    "id": "demo_health",
    "type": "function",
    "name": "Saúde sintética (valores inventados)",
    "func": "const jitter = (base, spread) => Math.round((base + (Math.random() - 0.5) * spread) * 10) / 10;\nmsg.payload = {\n    cpu_temp: jitter(51, 6),\n    disk_used_pct: jitter(42, 0.4),\n    memory_used_pct: jitter(58, 8),\n    internet: 'online',\n    zigbee: 'online',\n    synthetic: true,\n};\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 400,
    "y": 360,
    "wires": [
      [
        "demo_health_out"
      ]
    ],
    "z": "demo_tab",
    "g": "demo_group_health"
  },
