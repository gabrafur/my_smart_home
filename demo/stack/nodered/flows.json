        "p": "payload"
      }
    ],
    "repeat": "",
    "crontab": "",
    "once": true,
    "onceDelay": "0.5",
    "topic": "",
    "payload": "{\"night_states\":[\"below_horizon\"],\"armed_states\":[\"armed_away\",\"armed_home\",\"armed_night\"]}",
