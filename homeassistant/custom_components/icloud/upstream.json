      "file": "__init__.py",
      "change": "bind reviewed native adapter and device subclass; automatic_session_recovery boolean defaults true; preserve setup retry and manual OTP delivery; close recovered primary-attempt incident and exact-entry reauth repair only after complete authenticated setup"
    },
    {
      "file": "loaded_contract.py",
      "change": "fixed in-process loaded binding booleans and allowlisted latest natural-call stages;no provider properties or diagnostic service calls;root-owned expiring collection scope"
    },
    {
      "file": "auth_gate.py",
      "change": "one saved-password primary attempt per confirmed session expiry; separate durable attempt marker; complete authenticated setup closes a recovered incident; token-only success, challenges and uncertainty never rearm; manual OTP and original auth-state schema preserved; locked admission of a confirmed device-service rejection never rearms a consumed primary attempt"
    },
    {
      "file": "native_bridge.py",
      "change": "direct native paused SRP with configured password and preserved trust tokens; no token-first fallback or automatic OTP/SMS; restart-safe recovery marker; one native setup retry after typed device-service auth rejection, without a primary-login loop; intercept native polling service-session rejections before the password repair; one persisted recovery without OTP delivery or repeated login"
    }
