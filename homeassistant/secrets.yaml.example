# Copie para secrets.yaml. Valores abaixo sao exemplos validos, nao dados reais.
# Copy to secrets.yaml. Values below are valid examples, not real data.

# Substitua 0.0 pelas coordenadas da instalacao antes de habilitar automacoes
# de presenca. Never commit the filled file.
home_latitude: 0.0
home_longitude: 0.0

# Nomes exibidos apenas no dashboard privado de localização.
resident_primary_display_name: Example Primary Resident
resident_secondary_display_name: Example Secondary Resident

# TV usada pela automacao Wake-on-LAN.
tv_sala_mac: "AA:AA:AA:AA:AA:AA"

# Integracao opcional Moni Mobile. Desabilite o package correspondente se nao
# usar esse provedor.
moni_mobile_host: alarm.example.invalid
moni_mobile_port: 7000
moni_mobile_username: CHANGE_ME
moni_mobile_app_password: CHANGE_ME
moni_mobile_alarm_code: CHANGE_ME
