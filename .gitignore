devices.json
snapshot.json
tinytuya.json
tuya-raw.json

# Home Assistant secrets and volatile state
#
# .storage/ is ignored WHOLESALE and deliberately: even the "boring" registries
# (core.device_registry, core.entity_registry, person, ...) carry MAC/BSSID
# addresses, per-device unique_ids, HomeKit pairing ids and resident names.
# Do NOT re-add per-file `!` exceptions here.
homeassistant/secrets.yaml
!homeassistant/secrets.yaml.example
homeassistant/.storage/
homeassistant/.ha_ws_token
homeassistant/.ha_run.lock
homeassistant/.cloud/
homeassistant/.ssh/
homeassistant/.cache/
homeassistant/*.db
homeassistant/*.db-*
homeassistant/*.log
homeassistant/*.log.*
homeassistant/home-assistant_v2.db*
homeassistant/home-assistant.log*
homeassistant/backups/
homeassistant/packages/private_bindings.yaml
homeassistant/codex_prompts/
homeassistant/tts/
homeassistant/custom_components/hacs/hacs_frontend/

# Node-RED runtime secrets and dependencies
nodered/node_modules/
nodered/.npm/
nodered/flows_cred.json
nodered/.flows_cred.json*
nodered/.sessions.json
nodered/.config.users.json*
nodered/.config.runtime.json*
nodered/context/
nodered/backups/
nodered/flows.json.bak*

# Tooling dependencies
node_modules/

# Mosquitto runtime and credentials
mosquitto/data/
mosquitto/log/
mosquitto/config/password.txt

# Zigbee2MQTT contains MQTT password and Zigbee network key
zigbee2mqtt/configuration.yaml
zigbee2mqtt/coordinator_backup.json
zigbee2mqtt/database.db
zigbee2mqtt/state.json
zigbee2mqtt/log/

# Portainer contains app database, keys, certs, and Docker state
portainer/

# Matter server contains fabric credentials and device pairing certs
matter-server/

# AppDaemon runtime config is container-owned. The reviewable source lives in
# templates/appdaemon/ and is mounted read-only by Compose.
appdaemon/appdaemon.yaml
appdaemon/secrets.yaml
