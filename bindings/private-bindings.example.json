{
  "schema_version": 1,
  "roles": {
    "resident_primary": {
      "enabled": true,
      "entities": {
        "person.resident_primary": {
          "target_entity_id": "person.example_resident_primary",
          "state_mode": "home_away"
        },
        "device_tracker.mobile_primary_source_1": {
          "target_entity_id": "device_tracker.example_mobile_primary",
          "state_mode": "passthrough",
          "force_update": true,
          "attributes": [
            "gps_accuracy",
            "latitude",
            "longitude",
            "source_type"
          ],
          "string_attributes": [
            "gps_accuracy",
            "latitude",
            "longitude"
          ]
        },
        "device_tracker.mobile_primary_source_2": {
          "target_entity_id": "device_tracker.example_mobile_primary_fallback",
          "state_mode": "passthrough",
          "force_update": true,
          "attributes": [
            "gps_accuracy",
            "latitude",
            "longitude",
            "source_type"
          ],
          "string_attributes": [
            "gps_accuracy",
            "latitude",
            "longitude"
          ]
        },
        "device_tracker.resident_primary_location": {
          "target_entity_ids": [
            "device_tracker.example_mobile_primary",
            "device_tracker.example_mobile_primary_fallback"
          ],
          "selection_mode": "best_location",
          "state_mode": "passthrough",
          "force_update": true,
          "display_name": "Example Primary Resident",
          "hide_targets": true,
          "source_names": [
            "Home Assistant App",
            "iCloud"
          ],
          "attributes": [
            "gps_accuracy",
            "latitude",
            "longitude",
            "source_type"
          ]
        }
      }
    },
    "resident_secondary": {
      "enabled": true,
      "entities": {
        "person.resident_secondary": {
          "target_entity_id": "person.example_resident_secondary",
          "state_mode": "home_away"
        },
        "device_tracker.mobile_secondary_source_1": {
          "target_entity_id": "device_tracker.example_mobile_secondary",
          "state_mode": "passthrough",
          "force_update": true,
          "attributes": [
            "gps_accuracy",
            "latitude",
            "longitude",
            "source_type"
          ],
          "string_attributes": [
            "gps_accuracy",
            "latitude",
            "longitude"
          ]
        },
        "device_tracker.mobile_secondary_source_2": {
          "target_entity_id": "device_tracker.example_mobile_secondary_fallback",
          "state_mode": "passthrough",
          "force_update": true,
          "attributes": [
            "gps_accuracy",
            "latitude",
            "longitude",
            "source_type"
          ],
          "string_attributes": [
            "gps_accuracy",
            "latitude",
            "longitude"
          ]
        },
        "device_tracker.resident_secondary_location": {
          "target_entity_ids": [
            "device_tracker.example_mobile_secondary",
            "device_tracker.example_mobile_secondary_fallback"
          ],
          "selection_mode": "best_location",
          "state_mode": "passthrough",
          "force_update": true,
          "display_name": "Example Secondary Resident",
          "hide_targets": true,
          "source_names": [
            "Home Assistant App",
            "iCloud"
          ],
          "attributes": [
            "gps_accuracy",
            "latitude",
            "longitude",
            "source_type"
          ]
        }
      }
    },
    "mobile_primary": {
      "enabled": true,
      "entities": {
        "device_tracker.mobile_primary": {
          "target_entity_id": "device_tracker.example_mobile_primary",
          "state_mode": "passthrough"
        }
      },
      "services": {
        "notify": { "target_service": "notify.example_voice_assistant" },
        "notify_3": {
          "target_service": "notify.send_message",
          "target_entity_id": "notify.example_mobile_primary"
        },
        "notify_actionable": {
          "target_service": "notify.mobile_app_example_primary"
        }
      }
    },
    "mobile_secondary": {
      "enabled": false,
      "entities": {},
      "services": {
        "notify_2": {
          "target_service": "notify.send_message",
          "target_entity_id": "notify.example_mobile_secondary"
        },
        "notify_actionable": {
          "target_service": "notify.mobile_app_example_secondary"
        }
      }
    },
    "vehicle_primary": {
      "enabled": true,
      "entities": {
        "device_tracker.vehicle_primary": {
          "target_entity_id": "device_tracker.example_vehicle_primary",
          "state_mode": "passthrough",
          "display_name": "Example Vehicle",
          "hide_targets": true,
          "source_names": ["Bluelink"],
          "attributes": [
            "gps_accuracy",
            "latitude",
            "longitude",
            "source_type"
          ]
        },
        "button.vehicle_primary_force_refresh": {
          "target_entity_id": "button.example_vehicle_primary_force_refresh",
          "state_mode": "passthrough",
          "hide_targets": true
        },
        "button.garagem_vehicle_primary_refresh_trip_info": {
          "target_entity_id": "button.example_vehicle_primary_refresh_trip_info",
          "state_mode": "passthrough",
          "hide_targets": true
        },
        "lock.vehicle_primary_door_lock": {
          "target_entity_id": "lock.example_vehicle_primary_door_lock",
          "state_mode": "passthrough",
          "hide_targets": true
        },
        "switch.vehicle_primary_climate": {
          "target_entity_id": "switch.example_vehicle_primary_climate",
          "state_mode": "boolean",
          "hide_targets": true
        }
      },
      "services": {
        "force_refresh": {
          "target_service": "button.press",
          "target_public_entity_id": "button.vehicle_primary_force_refresh"
        },
        "refresh_trip_info": {
          "target_service": "button.press",
          "target_public_entity_id": "button.garagem_vehicle_primary_refresh_trip_info"
        },
        "climate_on": {
          "target_service": "switch.turn_on",
          "target_public_entity_id": "switch.vehicle_primary_climate"
        },
        "climate_off": {
          "target_service": "switch.turn_off",
          "target_public_entity_id": "switch.vehicle_primary_climate"
        },
        "lock": {
          "target_service": "lock.lock",
          "target_public_entity_id": "lock.vehicle_primary_door_lock"
        }
      }
    },
    "garage_gate": {
      "enabled": true,
      "entities": {
        "binary_sensor.garage_gate": {
          "target_entity_id": "binary_sensor.example_garage_gate",
          "state_mode": "boolean"
        }
      },
      "services": {
        "pulse": {
          "target_service": "script.turn_on",
          "target_entity_id": "script.example_garage_gate_pulse"
        }
      },
      "topics": {
        "relay_state": "zigbee2mqtt/example_garage_gate_relay/state",
        "action": "zigbee2mqtt/example_garage_gate_remote/action",
        "command": "zigbee2mqtt/example_garage_gate_relay/set",
        "state": "zigbee2mqtt/example_garage_gate_relay/state"
      }
    },
    "exterior_light": {
      "enabled": true,
      "entities": {
        "light.exterior_light": {
          "target_entity_id": "light.example_exterior_light",
          "state_mode": "boolean",
          "allowed_services": ["light.turn_on", "light.turn_off"]
        }
      },
      "mqtt_topics": [
        {
          "topic": "zigbee2mqtt/example_exterior_light_1/set",
          "payload_on": "ON",
          "payload_off": "OFF"
        },
        {
          "topic": "zigbee2mqtt/example_exterior_light_2/set",
          "payload_on": "ON",
          "payload_off": "OFF"
        }
      ]
    },
    "security_panel": {
      "enabled": true,
      "entities": {
        "alarm_control_panel.security_panel": {
          "target_entity_id": "alarm_control_panel.example_security_panel",
          "state_mode": "passthrough"
        }
      },
      "services": {
        "arm_away": {
          "target_service": "alarm_control_panel.alarm_arm_away",
          "target_public_entity_id": "alarm_control_panel.security_panel",
          "data": { "code": "0000" }
        },
        "disarm": {
          "target_service": "alarm_control_panel.alarm_disarm",
          "target_public_entity_id": "alarm_control_panel.security_panel",
          "data": { "code": "0000" }
        }
      }
    }
  }
}
