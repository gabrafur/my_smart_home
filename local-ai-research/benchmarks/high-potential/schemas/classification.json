{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "abstain": {
      "type": "boolean"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "eligible": {
      "type": "boolean"
    },
    "labels": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "requires_primary_review": {
      "type": "boolean"
    }
  },
  "required": [
    "labels",
    "eligible",
    "requires_primary_review",
    "abstain",
    "confidence"
  ],
  "type": "object"
}
