{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "commands": {
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "command": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          },
          "status": {
            "enum": [
              "success",
              "failed"
            ],
            "type": "string"
          }
        },
        "required": [
          "command",
          "exit_code",
          "status"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "commands"
  ],
  "type": "object"
}
