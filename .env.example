# Copie para .env e preencha. O .env real NUNCA e versionado (ver .gitignore).
# Copy to .env and fill it in. NEVER commit the real .env file.

# Fuso horario IANA / IANA time zone.
TZ=America/Sao_Paulo

# IP do host na LAN. Os servicos bridged publicam SOMENTE neste IP; se a
# variavel faltar, o docker-compose cai para 127.0.0.1 de proposito, para nao
# expor nada em 0.0.0.0 por acidente.
HOST_LAN_IP=127.0.0.1

# GID numerico de /var/run/docker.sock, usado somente pelo claude-bridge.
# Descubra com: stat -c '%g' /var/run/docker.sock
DOCKER_GID=999

# Identidade usada no broker MQTT. A senha fica somente no password.txt e nos
# consumidores privados, nunca neste arquivo de exemplo.
MQTT_USER=smart_home

# Node-RED admin (gere com scripts/setup-node-red-security.mjs)
NODE_RED_ADMIN_USER=admin
NODE_RED_ADMIN_PASSWORD_HASH=replace-with-generated-bcrypt-hash
NODE_RED_CREDENTIAL_SECRET=replace-with-node-red-credential-secret

# Home Assistant / bridge de agentes. O token do HA e consumido apenas pelo
# script de atualizacao; prefira .local-secrets/ha-long-lived-token.txt.
HA_LONG_LIVED_TOKEN=
CLAUDE_BRIDGE_TOKEN=replace-with-random-token-openssl-rand-hex-32
CLAUDE_CODE_OAUTH_TOKEN=

# Revisao documental semanal em UTC: 0=domingo, 1=segunda, ..., 6=sabado.
# Weekly documentation review in UTC: 0=Sunday, 1=Monday, ..., 6=Saturday.
WEEKLY_DOCS_REVIEW_DAY_UTC=1
WEEKLY_DOCS_REVIEW_HOUR_UTC=6
WEEKLY_DOCS_REVIEW_MINUTE_UTC=0
WEEKLY_DOCS_REVIEW_BRANCH=main
WEEKLY_DOCS_REVIEW_REMOTE=origin
WEEKLY_DOCS_REVIEW_TIMEOUT_MS=10800000
REPO_UID=1000
REPO_GID=1000
# A chave deve poder enviar para o repositorio, mas e montada somente para
# leitura no container. Prefira uma deploy key exclusiva deste repositorio.
# The key needs repository push access, but its container mount is read-only.
WEEKLY_DOCS_REVIEW_SSH_KEY=/path/to/repository-deploy-key
WEEKLY_DOCS_REVIEW_KNOWN_HOSTS=/path/to/known_hosts

# Geolocalizacao usada pelo fluxo iluminacao_seguranca (Node-RED).
# HOME_* = ponto de referencia da casa; GATE_* = portao/entrada, alguns metros
# antes, usado para acender o refletor um pouco antes da chegada.
# Ficam aqui (e nao no flows.json) porque o repositorio e publico: a coordenada
# de casa e, na pratica, o endereco da residencia. Se faltarem, o fluxo degrada
# para o estado de zona do Home Assistant em vez de calcular distancias.
HOME_LAT=CHANGE_ME
HOME_LON=CHANGE_ME
GATE_LAT=CHANGE_ME
GATE_LON=CHANGE_ME
