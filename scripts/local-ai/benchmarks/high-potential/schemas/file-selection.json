{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "needs_full_context": {
      "type": "boolean"
    },
    "selected_files": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "selected_files",
    "needs_full_context",
    "confidence"
  ],
  "type": "object"
}
