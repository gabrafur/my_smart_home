{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "duration_seconds": {
      "minimum": 0,
      "type": "number"
    },
    "error_code": {
      "pattern": "^E-[0-9]{3}$",
      "type": "string"
    },
    "file": {
      "minLength": 1,
      "type": "string"
    },
    "line": {
      "minimum": 1,
      "type": "integer"
    },
    "task_id": {
      "pattern": "^T-[0-9]{3}$",
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "duration_seconds",
    "error_code",
    "file",
    "line"
  ],
  "type": "object"
}
