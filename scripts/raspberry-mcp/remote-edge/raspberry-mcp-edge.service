[Unit]
Description=Optional OAuth edge for the Raspberry MCP (behind Tailscale Funnel)
Requires=raspberry-mcp-http.service
After=raspberry-mcp-http.service

[Service]
Type=simple
User=raspberry-mcp-edge
Group=raspberry-mcp-edge
SupplementaryGroups=raspberry-mcp-http
ExecStart=/usr/bin/python3 -I -S -B /usr/local/lib/raspberry-mcp-edge/edge.py
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET
RestrictSUIDSGID=yes
LockPersonality=yes
InaccessiblePaths=-/mnt/data/docker -/run/docker.sock -/root -/run/raspberry-mcp
ReadOnlyPaths=/var/lib/raspberry-mcp-edge /var/lib/raspberry-mcp-http
ReadWritePaths=/var/lib/raspberry-mcp-edge/state
TasksMax=32
CPUQuota=15%
LimitAS=201326592
LimitNOFILE=128
LimitCORE=0
StandardOutput=null
StandardError=journal
Restart=no

[Install]
WantedBy=multi-user.target
