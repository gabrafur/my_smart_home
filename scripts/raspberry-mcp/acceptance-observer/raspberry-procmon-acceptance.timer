[Unit]
Description=Eight fixed observation times; no repair or privilege renewal

[Timer]
OnCalendar=2026-10-25 04:30:00 UTC
OnCalendar=2026-10-25 15:20:00 UTC
OnCalendar=2026-10-25 20:33:00 UTC
OnCalendar=2026-10-26 11:00:00 UTC
OnCalendar=2026-10-26 16:00:00 UTC
OnCalendar=2026-10-26 20:00:00 UTC
OnCalendar=2026-10-27 23:00:00 UTC
OnCalendar=2026-10-28 10:00:00 UTC
AccuracySec=1s
RandomizedDelaySec=0
Persistent=true
Unit=raspberry-procmon-acceptance.service

[Install]
WantedBy=timers.target
