[Unit]
Description=Fixed readonly Node-RED runtime and Kia updater projection
Requires=raspberry-nodered-diagnostics.socket
After=raspberry-nodered-diagnostics.socket
[Service]
User=__OPERATOR_NATIVE_ACCOUNT__
Group=raspberry-mcp
ExecStartPre=!/usr/bin/python3 -I -S -B /usr/local/lib/raspberry-nodered-diagnostics/root_snapshot.py
ExecStart=/usr/bin/node --jitless --no-expose-wasm --max-old-space-size=128 /usr/local/lib/raspberry-nodered-diagnostics/sidecar.cjs
LoadCredential=node-red-password:/mnt/data/docker/.local-secrets/node-red-admin-password.txt
LoadCredential=ha-token:/mnt/data/docker/.local-secrets/ha-long-lived-token.txt
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
ReadWritePaths=/var/lib/raspberry-nodered-diagnostics
InaccessiblePaths=-/mnt/data/docker/.env -/mnt/data/docker/.local-secrets -/mnt/data/docker/homeassistant -/mnt/data/docker/nodered/.config.runtime.json -/mnt/data/docker/nodered/flows_cred.json -/run/docker.sock
BindReadOnlyPaths=-/mnt/data/docker/homeassistant/.storage/kia_uvo_safe_update:/run/raspberry-nodered-diagnostics-inputs/safe-update
BindReadOnlyPaths=-/mnt/data/docker/homeassistant/.daily-update-trigger/kia-uvo-result:/run/raspberry-nodered-diagnostics-inputs/worker
BindReadOnlyPaths=-/mnt/data/docker/.local-state/kia-uvo-merge/status.json:/run/raspberry-nodered-diagnostics-inputs/merge
BindReadOnlyPaths=-/mnt/data/docker/.local-state/kia-uvo-merge/promotion-status.json:/run/raspberry-nodered-diagnostics-inputs/promotion
BindReadOnlyPaths=-/mnt/data/docker/.local-state/kia-uvo-merge/promotion-public-status.json:/run/raspberry-nodered-diagnostics-inputs/promotion-public
BindReadOnlyPaths=-/mnt/data/docker/homeassistant/.daily-update-trigger/kia-uvo-requested:/run/raspberry-nodered-diagnostics-inputs/audit-requested
BindReadOnlyPaths=-/mnt/data/docker/homeassistant/.daily-update-trigger/kia-uvo-processing:/run/raspberry-nodered-diagnostics-inputs/audit-processing
BindReadOnlyPaths=-/mnt/data/docker/homeassistant/.daily-update-trigger/kia-uvo-followup:/run/raspberry-nodered-diagnostics-inputs/audit-followup
BindReadOnlyPaths=-/mnt/data/docker/.local-state/kia-uvo-merge-trigger/requested:/run/raspberry-nodered-diagnostics-inputs/merge-requested
BindReadOnlyPaths=-/mnt/data/docker/.local-state/kia-uvo-merge-trigger/processing:/run/raspberry-nodered-diagnostics-inputs/merge-processing
BindReadOnlyPaths=-/run/docker.sock:/run/raspberry-nodered-diagnostics-inputs/docker.sock
MemoryMax=256M
CPUQuota=20%
TasksMax=12
LimitCORE=0
RuntimeMaxSec=300
TimeoutStartSec=15
TimeoutStopSec=5
UMask=0077
StandardOutput=null
StandardError=journal
